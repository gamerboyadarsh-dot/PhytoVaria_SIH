# Base URL of Member 2's FastAPI backend.
# Leave as /api to use the Vite dev proxy defined in vite.config.js.
VITE_API_BASE_URL=/api

# When true, the app uses mock fixtures from src/api/mockData.js instead of
# calling the backend. Useful for frontend work before endpoints exist, and
# as the Demo Sensor Mode fallback if the ESP32/backend is down.
VITE_DEMO_MODE=true
